# ─── Core ──────────────────────────────────────────────────────────────
# Public base URL (no trailing slash). Used for canonical URLs, sitemap, emails, OG.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL 15+ (Neon, Supabase, RDS, self-hosted…)
DATABASE_URL=postgres://sifra:sifra@localhost:5432/sifra

# 32+ random chars. `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-of-32-chars
# 32-byte key, base64. Encrypts prescriptions & uploaded Rx files at rest (GDPR art. 9).
# `openssl rand -base64 32`
DATA_ENCRYPTION_KEY=

# ─── Social login (optional) ───────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Storage ───────────────────────────────────────────────────────────
# local  → files in STORAGE_DIR (default ./storage)
# s3     → any S3-compatible bucket (Cloudflare R2, MinIO, AWS S3)
STORAGE_DRIVER=local
STORAGE_DIR=./storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── Email ─────────────────────────────────────────────────────────────
# Leave SMTP_HOST empty in development: emails are written to .data/outbox/*.html
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Sifra Vision <comenzi@sifravision.ro>"
# Internal notifications (new orders, bookings, B2B applications)
MAIL_STAFF=

# ─── Payments ──────────────────────────────────────────────────────────
# Netopia Payments (API v2) — https://doc.netopia-payments.com
NETOPIA_API_KEY=
NETOPIA_POS_SIGNATURE=
NETOPIA_SANDBOX=true
# RSA public key from the NETOPIA admin (PEM; newlines as \n) — verifies IPN JWTs
NETOPIA_PUBLIC_KEY=
# Stripe (alternative card processor)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Invoicing (RO e-Factura via SmartBill) ────────────────────────────
SMARTBILL_USER=
SMARTBILL_TOKEN=
SMARTBILL_CIF=
SMARTBILL_SERIES=SV

# ─── Analytics (loaded only after cookie consent) ──────────────────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ─── Virtual try-on (MediaPipe) — self-hosted by default ───────────────
NEXT_PUBLIC_MEDIAPIPE_WASM_URL=/vendor/mediapipe/wasm
NEXT_PUBLIC_FACE_MODEL_URL=/vendor/mediapipe/face_landmarker.task
